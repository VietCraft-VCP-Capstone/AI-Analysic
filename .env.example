MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=data-collection          # Google Trends          (mặc định: data-collection)
MONGO_DB_SEED=vietcraft-seed        # dữ liệu mồi            (mặc định: vietcraft-seed)
MONGO_DB_LIVE=vietcraft             # sàn live thật          (mặc định: vietcraft)

# Cổng FastAPI                                               (mặc định: 8000)
PORT=8000

PRINTIFY_TOKEN=
ETSY_API_KEY=

# Không dùng tới trong module AI (còn sót từ khung dự án gốc).
DATABASE_URL=

AI_GATEWAY_SECRET=                  # giống hệt BE/.env
# LI_MODEL_DIR=~/.cache/vietcraft-li/siglip2-base-patch16-224   # thư mục model ONNX
LI_TREND_DB=data-collection         # DB chứa trend_interest cho Listing Intel

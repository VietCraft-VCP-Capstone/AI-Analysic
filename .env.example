MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=data-collection          # Google Trends          (mặc định: data-collection)
MONGO_DB_SEED=vietcraft-seed        # dữ liệu mồi            (mặc định: vietcraft-seed)
MONGO_DB_LIVE=vietcraft             # sàn live thật          (mặc định: vietcraft)

# Cổng FastAPI                                               (mặc định: 8000)
PORT=8000

PRINTIFY_TOKEN=
ETSY_API_KEY=

# Không dùng tới trong module AI (còn sót từ khung dự án gốc).
DATABASE_URL=

AI_GATEWAY_SECRET=                  # giống hệt BE/.env
# LI_MODEL_DIR=../ai-data-train-prod/models/siglip2-base-patch16-224   # thư mục model ONNX, mặc định dùng thư mục này nếu đã tạo, không thì ~/.cache/vietcraft-li
LI_TREND_DB=data-collection         # DB chứa trend_interest cho Listing Intel

# Khoa LLM: chi dien vao app/.env (da bi gitignore), khong commit khoa that.
# Thu tu: OPENAI (chinh) > GEMINI (du phong) > ANTHROPIC (chi van ban ngan). Loi/het han muc se tu chuyen sang cai ke tiep. Chi AI service giu khoa, BE khong can.
GEMINI_API_KEY=your_key_here
GEMINI_API_KEY_2=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_OPENAI_MODELS=gpt-4o-mini   # model OpenAI (thu lan luot, cach nhau dau phay)
# LLM_GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite   # du phong khi OpenAI loi/het han muc
# COMPETITOR_SUBKIND=0   # tat loc doi thu theo loai nho (mac dinh bat), quay ve so khop TF-IDF cu

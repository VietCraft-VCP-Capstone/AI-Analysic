# Chép file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
#
# .env đã nằm trong .gitignore (dòng 59) — KHÔNG commit nó.
# Code nạp .env ở app/.env trước, rồi tới AI-Analysic/.env (app/config.py dòng 14-21).


# ─── BẮT BUỘC ────────────────────────────────────────────────────────────────

# Chuỗi kết nối MongoDB Atlas. Hỏi người giữ quyền Atlas để lấy.
# Cụm đang dùng là M0 free 512 MB, DÙNG CHUNG CẢ NHÓM — ghi hàng loạt thì chia
# nhỏ theo tháng, vượt hạn mức là Atlas chặn ghi với tất cả mọi người.
# (code cũng chấp nhận tên MONGO_URI — đặt một trong hai là đủ)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority


# ─── TÙY CHỌN — bỏ trống là dùng mặc định trong ngoặc ─────────────────────────

# Ba database. Để nguyên trừ khi bạn chạy trên cụm riêng của mình.
# (MONGODB_DB cũng có tên thay thế là MONGO_DB_DATA — đặt một trong hai)
MONGODB_DB=data-collection          # Google Trends          (mặc định: data-collection)
MONGO_DB_SEED=vietcraft-seed        # dữ liệu mồi            (mặc định: vietcraft-seed)
MONGO_DB_LIVE=vietcraft             # sàn live thật          (mặc định: vietcraft)

# Cổng FastAPI                                               (mặc định: 8000)
PORT=8000

# Thư mục dữ liệu Parquet đã kéo về đĩa.                     (mặc định: ../vc-data)
# Chỉ đặt khi bạn để vc-data/ ở chỗ khác.
# VC_DATA_DIR=/duong/dan/toi/vc-data

# ─── GATEWAY BE SÀN — đường chạy thật ────────────────────────────────────────
#
# BE sàn (Node) xác thực người bán, tự tra shop, rồi gọi sang đây kèm hai header
# X-Gateway-Secret + X-Shop-Id. Đặt CÙNG một chuỗi ở BE (BE/.env, cùng tên biến).
# Để trống = tắt đường gateway, BE sàn sẽ nhận 401.
# Sinh chuỗi:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# AI_GATEWAY_SECRET=


# ─── TẮT XÁC THỰC LÚC LÀM TÍNH NĂNG — cả hai mặc định TẮT ────────────────────
#
# ⚠ CHỈ dùng khi đang viết tính năng trên máy mình. Bật lên là BỎ HẲN kiểm tra
#   quyền: ai gọi API cũng thành người bán, xem được dữ liệu shop bất kỳ.
#   Server in cảnh báo to lúc khởi động khi thấy đang bật. TẮT trước khi demo.
#
# Cần có vì SPEC-04 (đọc token đăng nhập của sàn) chưa xong — chưa tồn tại token
# hợp lệ nào để mà test. Xong SPEC-04 thì xoá hai dòng này.

# Tắt hẳn: mọi request thành shop này, không cần token, không cần header.
# DEV_SHOP_ID=shp_00017

# Hoặc nhẹ hơn: vẫn phải gửi header X-Debug-Shop-Id, nhưng đổi được shop giữa các
# request — dùng khi cần thử "shop A có xem được dữ liệu shop B không" (BR-174/177).
# DEV_TRUST_SHOP_HEADER=1


# Danh sách origin của FE được phép gọi, cách nhau bằng dấu phẩy.
# (mặc định: localhost 3000, 5173, 4174). KHÔNG dùng "*" — trình duyệt từ chối
# "*" khi có credentials, và nó cho mọi trang web đọc dữ liệu người đang đăng nhập.
# CORS_ORIGINS=http://localhost:3000,https://vietcraft.vn


# Token API ngoài — hiện chỉ collectors dùng, không có thì phần còn lại vẫn chạy.
PRINTIFY_TOKEN=
ETSY_API_KEY=

# Không dùng tới trong module AI (còn sót từ khung dự án gốc).
DATABASE_URL=
